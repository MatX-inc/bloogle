cabal-version:      1.18
build-type:         Simple
name:               bloogle
version:            0.1.0
license:            BSD3
license-file:       LICENSE
category:           Development
author:             Neil Mitchell <ndmitchell@gmail.com>
maintainer:         Neil Mitchell <ndmitchell@gmail.com>
copyright:          Neil Mitchell 2004-2026
synopsis:           Bluespec API Search
description:
    Bloogle is a Bluespec API search engine, which allows you to
    search the Bluespec standard libraries by either function name,
    or by approximate type signature. It is a fork of Hoogle.
homepage:           https://bloogle.bluespec.dev/
bug-reports:        https://github.com/MatX-inc/bloogle/issues
tested-with:        GHC==9.8, GHC==9.6, GHC==9.4
extra-doc-files:
    README.md
    CHANGES.txt
extra-source-files:
    cbits/*.h
    cbits/*.c
data-files:
    misc/sample-data/henry.txt
    misc/sample-data/emily-1.11/emily.txt
    misc/sample-data/emily-1.2/emily.txt
    html/*.js
    html/*.png
    html/*.css
    html/*.xml
    html/*.html

source-repository head
    type:     git
    location: https://github.com/MatX-inc/bloogle.git

library
    hs-source-dirs:     src
    default-language:   Haskell2010

    build-depends:
        QuickCheck,
        aeson >= 2,
        ansi-terminal,
        base >= 4 && < 5,
        blaze-html,
        blaze-markup,
        binary,
        bytestring >= 0.10.2.0,
        Cabal-syntax >= 3.8,
        cmdargs,
        conduit >= 1.3.0,
        conduit-extra >= 1.2.3.2,
        containers >= 0.5,
        data-default-class,
        deepseq,
        directory,
        extra >= 1.6.6,
        filepath,
        ghc-lib-parser >= 9.6.5 && < 9.16,
        old-locale,
        hashable,
        haskell-src-exts >= 1.22 && < 1.24,
        http-types,
        mmap,
        prometheus-client,
        safe >= 0.3.20,
        storable-tuple,
        tar,
        temporary,
        text >= 2,
        time >= 1.5,
        transformers,
        uniplate,
        utf8-string >= 0.3.1,
        vector,
        wai,
        wai-logger,
        wai-middleware-prometheus,
        warp,
        warp-tls >= 3.4.2,
        zlib

    c-sources:        cbits/text_search.c
    include-dirs:     cbits
    includes:         include.h
    install-includes: include.h
    cc-options:       -std=c99

    ghc-options:      -fno-state-hack -Wall
    if impl(ghc < 8.0)
        build-depends: semigroups >= 0.18

    exposed-modules:
        Bloogle

    other-modules:
        Paths_bloogle
        Action.CmdLine
        Action.Generate
        Action.Search
        Action.Server
        Action.Test
        Input.Cabal
        Input.Haddock
        Input.Item
        Input.ParseDecl
        Input.Reorder
        Output.Items
        Output.Names
        Output.Tags
        Output.Types
        Query
        General.Conduit
        General.IString
        General.Log
        General.Store
        General.Str
        General.Template
        General.Timing
        General.Util
        General.Web


executable bloogle
    main-is:            src/Main.hs
    default-language:   Haskell2010
    ghc-options:        -threaded -rtsopts -Wall

    build-depends:
        base >= 4 && < 5,
        bloogle
