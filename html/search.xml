<?xml version="1.0" encoding="UTF-8"?>
<OpenSearchDescription xmlns="http://a9.com/-/spec/opensearch/1.1/">
    <ShortName>Bloogle</ShortName>
    <LongName>Bloogle - Bluespec API Search</LongName>
    <Description>
        Bloogle is a Bluespec API search engine, which allows you to
        search the Bluespec standard libraries by either function name,
        or by approximate type signature.
    </Description>
    <Tags>bluespec</Tags>
    <Url type="text/html" template="#{home}/?bloogle={searchTerms}"/>
    <Url type="application/x-suggestions+json" template="#{home}/?bloogle={searchTerms}&amp;mode=suggest"/>

    <Image height="16" width="16" type="image/png">#{home}/favicon.png</Image>
    <Image height="64" width="64" type="image/png">#{home}/favicon64.png</Image>
    <Developer>Neil Mitchell</Developer>
    <AdultContent>false</AdultContent>
    <Language>en-us</Language>
    <OutputEncoding>UTF-8</OutputEncoding>
    <InputEncoding>UTF-8</InputEncoding>
</OpenSearchDescription>
